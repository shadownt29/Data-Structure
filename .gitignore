# 1. Ignore everything in the root directory
/*

# 2. Allow the root .gitignore and README files to be tracked
!.gitignore
!README.md

# 3. Allow Git to look into the src directory
!src/

# 4. Ignore everything inside the src directory by default
src/*

# 5. Make explicit exceptions for the folders you want to keep
!src/Assignment0/
!src/Assignment1/
!src/Assignment2/
!src/Assignment3/
!src/Bogosort/
!src/inClass/
